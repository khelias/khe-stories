# The request service's settings (docs/decisions/002). The real values live only in the
# homelab's services/apps/stories/.env; names and the phrase never come to this repo.

# Who a device may be paired to, comma-separated: the authors the stories repo accepts.
CHILDREN=
# `echo '<phrase>' | node notify.ts --hash-phrase` (estate ADR-038).
FAMILY_PHRASE_HASH=
# A fine-grained PAT on the stories repo with Actions: write only.
GITHUB_TOKEN=
GITHUB_REPO=khelias/khe-bunny-tales
GITHUB_WORKFLOW=kids-story.yml
# Turns a recorded idea into text; its own Google Cloud project, not the adventure key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
# `node notify.ts --vapid-keys`; the subject is a mailto: address push services may write to.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Starting values, unverified. The monthly cap leaves 300 of the plan's 2000 Actions minutes
# for the stories repo's own builds after the other private repos' use, at about 35 minutes a
# story (estate ADR-037, measured 2026-11-17).
CAP_PER_CHILD_PER_DAY=3
CAP_PER_MONTH=25
CAP_QUEUED=5
# What the compose view says a story takes, and when a silent run is asked about.
MINUTES_PER_STORY=35
TIMEOUT_MINUTES=90

PORT=3000
DB_PATH=/data/stories.db
# The family build's catalog, mounted read-only from the deploy's directory.
CATALOG_PATH=/app-build/catalog.json
TZ=Europe/Tallinn
